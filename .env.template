# Observability shipper for this host. Copy to .env, fill in, chmod 600.
#
#   cp .env.template .env && chmod 600 .env && $EDITOR .env
#
# Compose reads this automatically from the directory it runs in, so keep
# these files in their own directory rather than beside an application's
# own .env.

# --- identity ---------------------------------------------------------
# PROJECT_NAME       the project= label on every log line and metric.
# CONTAINER_PREFIX   which containers on this box belong to this project.
#                    Usually the same as PROJECT_NAME. Anything not matching
#                    <prefix>, <prefix>-* or system-* is never collected.
#
#                    Interpolated into a regex, so alternatives are separated
#                    by a pipe, never a comma:
#                        CONTAINER_PREFIX=shop|checkout
#                    A bare * is not a wildcard and will fail to load. To
#                    collect every container on the host, use:
#                        CONTAINER_PREFIX=.*
#                    Think before you do: the same filter guards cAdvisor,
#                    whose per-container series are the bulk of what this
#                    ships, and a remote-write receiver has no ingestion
#                    limit to fall back on.
# PROJECT_HOSTNAME   the host= label. Use a name you will recognise in a
#                    dashboard, not an auto-generated instance hostname.
PROJECT_NAME=
CONTAINER_PREFIX=
PROJECT_ENVIRONMENT=production
PROJECT_HOSTNAME=

# Also used to interpret nginx error-log timestamps, which carry no UTC
# offset. Must match the zone nginx writes in, not your own.
TZ=UTC

# --- where this host ships to -----------------------------------------
# Both endpoints are on the same host, two paths. No default on purpose:
# a wrong value here sends a host's logs to the wrong aggregator, and
# nothing about that failure is loud.
#
# Private (same VPC or peered), plain HTTP over an internal name:
#   LOKI_ENDPOINT=http://logs.internal.example:8100/loki/api/v1/push
#   METRICS_ENDPOINT=http://logs.internal.example:8100/api/v1/write
#
# Published ingest host, HTTPS with a per-host credential:
#   LOKI_ENDPOINT=https://logs.example.com/loki/api/v1/push
#   METRICS_ENDPOINT=https://logs.example.com/api/v1/write
LOKI_ENDPOINT=
METRICS_ENDPOINT=

# One credential covers both signals. Leave BOTH blank when shipping over a
# private path where the network itself is the authorisation -- Alloy sends
# no Authorization header when these are empty.
INGEST_USERNAME=
INGEST_PASSWORD=

# --- optional ----------------------------------------------------------
# Host directory holding app-written *.log files, if this host has any.
#APP_LOG_DIR=/opt/apps/<project>/logs

# Host directory of per-vhost nginx logs, if this host serves sites.
# Expects <site>-access.log / <site>-error.log; the site= label is the
# filename stem. Leave unset on boxes without nginx.
#NGINX_LOG_DIR=/var/log/nginx
#
# Those files are normally www-data:adm 0640 and Alloy runs as uid 473, so
# it must join the adm group to read them. Find the id with:
#   getent group adm
#ALLOY_GID=4

#ALLOY_DEBUG_PORT=12345

# --- image versions ----------------------------------------------------
# Pinned here rather than left to the compose file's defaults, so upgrading
# a fleet is one visible line per image.
ALLOY_IMAGE=grafana/alloy:v1.17.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
