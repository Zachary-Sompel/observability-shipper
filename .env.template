# Observability shipper for this host. Copy to .env, fill in, chmod 600.
#
#   cp .env.template .env && chmod 600 .env && $EDITOR .env
#
# Compose reads this automatically from the directory it runs in, so keep
# these files in their own directory rather than beside an application's
# own .env.

# --- identity ---------------------------------------------------------
# PROJECT_NAME       the project= label on every log line and metric.
# CONTAINER_PREFIX   which containers on this box belong to this project.
#                    Usually the same as PROJECT_NAME. Anything not matching
#                    <prefix>, <prefix>-* or system-* is never collected.
#
#                    Interpolated into a regex, so alternatives are separated
#                    by a pipe, never a comma:
#                        CONTAINER_PREFIX=shop|checkout
#                    A bare * is not a wildcard and will fail to load. To
#                    collect every container on the host, use:
#                        CONTAINER_PREFIX=.*
#                    Think before you do: the same filter guards cAdvisor,
#                    whose per-container series are the bulk of what this
#                    ships, and a remote-write receiver has no ingestion
#                    limit to fall back on.
# PROJECT_HOSTNAME   the host= label, and the ONLY thing separating two boxes
#                    that share a PROJECT_NAME. It must be unique per box.
#
#                    Copy it between boxes and their node and cAdvisor series
#                    become identical: Prometheus then sees one series written
#                    by several senders with interleaved timestamps and rejects
#                    whatever arrives out of order, so metrics are silently
#                    lossy and "host stopped shipping" cannot fire for one box
#                    of several claiming to be the same host. Logs are
#                    unaffected, which is what makes it easy to miss.
#
#                    A fleet of three sharing a project reads:
#                      PROJECT_NAME=shop        PROJECT_HOSTNAME=shop-1
#                      PROJECT_NAME=shop        PROJECT_HOSTNAME=shop-2
#                      PROJECT_NAME=shop        PROJECT_HOSTNAME=shop-3
#
#                    Use a name you will recognise in a legend, not an
#                    auto-generated instance hostname.
PROJECT_NAME=
CONTAINER_PREFIX=
PROJECT_ENVIRONMENT=production
PROJECT_HOSTNAME=

# Also used to interpret nginx error-log timestamps, which carry no UTC
# offset. Must match the zone nginx writes in, not your own.
TZ=UTC

# --- where this host ships to -----------------------------------------
# Both endpoints are on the same host, two paths. No default on purpose:
# a wrong value here sends a host's logs to the wrong aggregator, and
# nothing about that failure is loud.
#
# Private (same VPC or peered), plain HTTP over an internal name:
#   LOKI_ENDPOINT=http://logs.internal.example:8100/loki/api/v1/push
#   METRICS_ENDPOINT=http://logs.internal.example:8100/api/v1/write
#
# Published ingest host, HTTPS with a per-host credential:
#   LOKI_ENDPOINT=https://logs.example.com/loki/api/v1/push
#   METRICS_ENDPOINT=https://logs.example.com/api/v1/write
LOKI_ENDPOINT=
METRICS_ENDPOINT=

# One credential covers both signals. Leave BOTH blank when shipping over a
# private path where the network itself is the authorisation -- Alloy sends
# no Authorization header when these are empty.
INGEST_USERNAME=
INGEST_PASSWORD=

# --- optional ----------------------------------------------------------
# Host directory holding app-written *.log files, if this host has any.
#APP_LOG_DIR=/opt/apps/<project>/logs

# Host directory of per-vhost nginx logs, if this host serves sites.
# Expects <site>-access.log / <site>-error.log; the site= label is the
# filename stem. Leave unset on boxes without nginx.
#NGINX_LOG_DIR=/var/log/nginx
#
# Those files are normally www-data:adm 0640 and Alloy runs as uid 473, so
# it must join the adm group to read them. Find the id with:
#   getent group adm
#ALLOY_GID=4

#ALLOY_DEBUG_PORT=12345

# NGINX_SITE_REGEX   how to get the site label out of an nginx log filename.
#                    Both common conventions work unset:
#                      example.com-access.log  ->  example.com
#                      access-example.com.log  ->  example.com
#                    Set it only for a box that names files some third way.
#                    Exactly one capture group; that group becomes the label.
#
#                    Whatever is left after stripping IS the label, so a
#                    filename carrying a box or environment prefix puts that
#                    prefix in the label too -- fine for grouping, but it will
#                    not match a domain any more.
#NGINX_SITE_REGEX=/var/log/nginx/(?:(?:access|error)-)?(.+?)(?:-(?:access|error))?\.log

# --- backfill -----------------------------------------------------------
# Both of these are for getting history in after the fact. Leave unset for
# normal running.
#
# LOG_MAX_AGE          Alloy drops lines older than this before shipping.
#                      Default 168h. The aggregator's Loki independently
#                      refuses anything past its reject_old_samples_max_age,
#                      so raising this alone is not enough -- both have to
#                      allow the age you are shipping.
#
# NGINX_BACKFILL_DIR   The HOST directory of decompressed rotated logs, named
#                      <site>-access.log / <site>-error.log. Read once and
#                      shipped with a backfill="true" label, which keeps them
#                      out of the live stream's ordering window while staying
#                      visible to every dashboard. Unset it when done.
#
#   mkdir -p /var/log/nginx-backfill
#   zcat /var/log/nginx/example.com-access.log.*.gz \
#     > /var/log/nginx-backfill/example.com-access.log
#   # set both vars, then:
#   docker compose up -d && docker compose logs -f alloy
#
#LOG_MAX_AGE=744h
#NGINX_BACKFILL_DIR=/var/log/nginx-backfill

# --- own uptime monitor ------------------------------------------------
# Access lines from our Uptime Kuma are dropped before shipping -- the address
# AND the Uptime-Kuma agent must both match. Regex alternation, dots escaped.
# Unset, nothing is dropped. Keep real addresses in .env only, not here.
#
#MONITOR_IPS=203\.0\.113\.10|198\.51\.100\.7

# --- image versions ----------------------------------------------------
# Pinned here rather than left to the compose file's defaults, so upgrading
# a fleet is one visible line per image.
ALLOY_IMAGE=grafana/alloy:v1.17.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
