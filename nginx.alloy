// Per-vhost nginx logs. Loaded only on hosts that serve sites: set
// NGINX_ALLOY_CONFIG=./nginx.alloy in .env, which swaps this file in for
// nginx.disabled.alloy. Alloy merges every *.alloy in /etc/alloy/config.d
// into one namespace, so loki.write.aggregator below is the component
// declared in config.alloy.
//
// This file is separate rather than part of config.alloy because
// stage.geoip opens its database when the component loads. In the shared
// config a box without the database would carry a permanently unhealthy
// component, which is indistinguishable from a shipper that is actually
// broken.

// One file per vhost: /var/log/nginx/<site>-access.log. The globs match
// only live files -- including .log.1 and .log.N.gz would re-ingest months
// of history on every start, and again each midnight as logrotate renames
// them into positions already seen.
local.file_match "nginx" {
  path_targets = [
    { __path__ = "/var/log/nginx/*-access.log", job = "nginx", service = "nginx-access" },
    { __path__ = "/var/log/nginx/*-error.log",  job = "nginx", service = "nginx-error"  },
  ]
}

// site comes from the path at discovery time rather than from a pipeline
// stage, so it is a real stream label before the first line is read. Kept
// verbatim: dashes are NOT converted back to dots, because a domain that
// genuinely contains a hyphen would be ambiguous.
discovery.relabel "nginx" {
  targets = local.file_match.nginx.targets

  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/nginx/(.+)-(?:access|error)\\.log"
    target_label  = "site"
  }
}

loki.source.file "nginx" {
  targets    = discovery.relabel.nginx.output
  forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
  forward_to = [loki.write.aggregator.receiver]

  stage.drop {
    older_than          = "168h"
    drop_counter_reason = "too_old_for_loki"
  }

  // 1:1 with site, and 283 long filenames make every label dropdown unusable.
  stage.label_drop {
    values = ["filename"]
  }

  stage.match {
    selector = "{service=\"nginx-access\"}"

    // Stock nginx `combined`. Only the client address and timestamp are
    // extracted here: method, path, status, referer and user agent are
    // parsed at query time with | pattern, which costs nothing until asked
    // for and works retroactively on lines already stored.
    stage.regex {
      expression = "^(?P<ip>\\S+) \\S+ \\S+ \\[(?P<ts>[^\\]]+)\\]"
    }

    // The offset is in the line, so no location is needed here.
    stage.timestamp {
      source = "ts"
      format = "02/Jan/2006:15:04:05 -0700"
    }

    // Country cannot be derived at query time -- it needs this database, so
    // the lookup has to happen as lines are read.
    stage.geoip {
      source  = "ip"
      db      = "/etc/alloy/geoip/GeoLite2-City.mmdb"
      db_type = "city"
    }

    // Structured metadata, NOT labels. As labels these would multiply
    // streams: 283 sites x ~200 countries is ~56,000 against a
    // max_streams_per_user of 5000, and Loki would start rejecting writes.
    // Structured metadata is stored per line and is queryable without
    // creating a stream.
    stage.structured_metadata {
      values = {
        country_code = "geoip_country_code",
        country_name = "geoip_country_name",
        city         = "geoip_city_name",
      }
    }

    stage.static_labels {
      values = { level = "info" }
    }
  }

  stage.match {
    selector = "{service=\"nginx-error\"}"

    // nginx error lines carry no UTC offset, so the host's zone has to be
    // supplied. A wrong value here shifts every error by hours and nothing
    // about that failure is loud.
    stage.regex {
      expression = "^(?P<ts>\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[(?P<level>\\w+)\\]"
    }
    stage.timestamp {
      source   = "ts"
      format   = "2006/01/02 15:04:05"
      location = sys.env("TZ")
    }
    stage.labels {
      values = { level = "" }
    }
  }
}
