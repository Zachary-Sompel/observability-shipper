// Logs to Loki, metrics to Prometheus, both on the central aggregator.
// Copy unchanged. Everything project-specific comes from .env.

logging {
  level  = "info"
  format = "logfmt"
}

// --- container logs --------------------------------------------------------

discovery.docker "containers" {
  host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // This project's containers plus the observability stack itself. Boxes are
  // often shared; anything else on the host is never read.
  //
  // The trailing group is optional, so a container named exactly after the
  // prefix is kept alongside its <prefix>-suffix siblings, and CONTAINER_PREFIX
  // set to .* collects every container on the host including names with no
  // hyphen at all. These regexes are fully anchored -- Alloy wraps them in
  // ^(?:...)$ -- so the prefix still has to match from the start of the name.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(" + sys.env("CONTAINER_PREFIX") + "|system)(-.*)?"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "tcp://docker-socket-proxy:2375"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  forward_to = [loki.write.aggregator.receiver]

  // Loki rejects entries older than 168h with a 400 that fails the whole
  // batch. On restart Alloy re-reads a container log from the beginning, so
  // without this a long-lived container's replay drops current lines too.
  // Alloy's own age gate, ahead of Loki's. It exists so a re-read of an old
  // file cannot flood ingest. Raise it with LOG_MAX_AGE to backfill, and note
  // it is only the first gate: the aggregator's Loki independently refuses
  // anything past reject_old_samples_max_age, and for nginx the live globs
  // match no rotated file at all. See the backfill block at the end.
  stage.drop {
    older_than          = coalesce(sys.env("LOG_MAX_AGE"), "168h")
    drop_counter_reason = "too_old_for_loki"
  }

  stage.static_labels {
    values = {
      job = "docker",
    }
  }

  // Lowercased: Grafana's level colouring and level-based panels match
  // lowercase, and emitters vary between WARN, Warn and warning.
  stage.regex {
    expression = "(?i)(?P<level>\\b(emergency|alert|critical|error|warning|warn|notice|info|debug)\\b)"
  }

  stage.template {
    source   = "level"
    template = "{{ if eq (ToLower .Value) \"warn\" }}warning{{ else }}{{ ToLower .Value }}{{ end }}"
  }

  stage.labels {
    values = {
      level = "",
    }
  }
}

// --- app-written log files -------------------------------------------------

local.file_match "app_logs" {
  path_targets = [
    {
      __path__    = "/app-logs/**/*.log",
      job         = "files",
      service     = sys.env("PROJECT_NAME") + "-app",
    },
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app_logs.receiver]
}

loki.process "app_logs" {
  forward_to = [loki.write.aggregator.receiver]

  // Alloy's own age gate, ahead of Loki's. It exists so a re-read of an old
  // file cannot flood ingest. Raise it with LOG_MAX_AGE to backfill, and note
  // it is only the first gate: the aggregator's Loki independently refuses
  // anything past reject_old_samples_max_age, and for nginx the live globs
  // match no rotated file at all. See the backfill block at the end.
  stage.drop {
    older_than          = coalesce(sys.env("LOG_MAX_AGE"), "168h")
    drop_counter_reason = "too_old_for_loki"
  }

  stage.regex {
    expression = "(?i)(?P<level>\\b(emergency|alert|critical|error|warning|warn|notice|info|debug)\\b)"
  }

  stage.template {
    source   = "level"
    template = "{{ if eq (ToLower .Value) \"warn\" }}warning{{ else }}{{ ToLower .Value }}{{ end }}"
  }

  stage.labels {
    values = {
      level = "",
    }
  }
}

// --- host metrics ----------------------------------------------------------

prometheus.exporter.unix "host" {
  rootfs_path = "/rootfs"
  procfs_path = "/rootfs/proc"
  sysfs_path  = "/rootfs/sys"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.aggregator.receiver]
  scrape_interval = "30s"
  job_name        = "node"
}

// --- container metrics -----------------------------------------------------

prometheus.scrape "cadvisor" {
  targets = [
    {"__address__" = "cadvisor:8080", "job" = "cadvisor"},
  ]
  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = "30s"
}

// cAdvisor reports every container on the host regardless of the log
// discovery filter, and per-container series are the bulk of what this ships.
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.aggregator.receiver]

  rule {
    source_labels = ["name"]
    regex         = "(" + sys.env("CONTAINER_PREFIX") + "|system)(-.*)?"
    action        = "keep"
  }
}

// --- Traefik metrics -------------------------------------------------------
// Inert unless TRAEFIK_METRICS_ADDR is set (host:port of Traefik's internal
// metrics entrypoint, e.g. edge-traefik:8082 -- Traefik must share the
// system-observability network with Alloy). For box 2 of the AWS site
// platform: certificate expiry (traefik_tls_certs_not_after) and box 1's
// health (traefik_service_server_up) are alerted on from these.
// Unset, the one target has an empty address and is dropped here.
discovery.relabel "traefik_metrics" {
  targets = [
    {"__address__" = coalesce(sys.env("TRAEFIK_METRICS_ADDR"), ""), "job" = "traefik"},
  ]

  rule {
    source_labels = ["__address__"]
    regex         = ""
    action        = "drop"
  }
}

prometheus.scrape "traefik" {
  targets         = discovery.relabel.traefik_metrics.output
  forward_to      = [prometheus.remote_write.aggregator.receiver]
  scrape_interval = "30s"
}

// --- Typesense metrics -----------------------------------------------------
// Inert unless TYPESENSE_METRICS_ADDR is set (host:port of the site platform's
// Typesense exporter, e.g. sitebuilder-typesense-exporter:9110 -- it joins the
// system-observability network; Typesense itself stays on its internal
// network). Box 1 of the AWS site platform: memory (box 1 is sized by it),
// search latency against the API's 250 ms deadline, documents per site.
discovery.relabel "typesense_metrics" {
  targets = [
    {"__address__" = coalesce(sys.env("TYPESENSE_METRICS_ADDR"), ""), "job" = "typesense"},
  ]

  rule {
    source_labels = ["__address__"]
    regex         = ""
    action        = "drop"
  }
}

prometheus.scrape "typesense" {
  targets         = discovery.relabel.typesense_metrics.output
  forward_to      = [prometheus.remote_write.aggregator.receiver]
  scrape_interval = "30s"
}

// --- ship ------------------------------------------------------------------

loki.write "aggregator" {
  external_labels = {
    project     = sys.env("PROJECT_NAME"),
    environment = sys.env("PROJECT_ENVIRONMENT"),
    host        = sys.env("PROJECT_HOSTNAME"),
  }

  endpoint {
    url = sys.env("LOKI_ENDPOINT")

    basic_auth {
      username = sys.env("INGEST_USERNAME")
      password = sys.env("INGEST_PASSWORD")
    }
  }
}

prometheus.remote_write "aggregator" {
  external_labels = {
    project     = sys.env("PROJECT_NAME"),
    environment = sys.env("PROJECT_ENVIRONMENT"),
    host        = sys.env("PROJECT_HOSTNAME"),
  }

  endpoint {
    url = sys.env("METRICS_ENDPOINT")

    basic_auth {
      username = sys.env("INGEST_USERNAME")
      password = sys.env("INGEST_PASSWORD")
    }
  }
}

// --- nginx per-site logs ---------------------------------------------------
// One file per vhost: /var/log/nginx/<site>-access.log. Inert unless
// NGINX_LOG_DIR is set: with it unset the compose file mounts /dev/null at
// /var/log/nginx and these globs match nothing.
//
// The globs match only live files -- including .log.1 and .log.N.gz would
// re-ingest months of history on every start, and again each midnight as
// logrotate renames them into positions already seen.
//
// No GeoIP here. Country is resolved centrally by the relay in front of
// Loki, so a fleet of nginx boxes shares one database and one update job
// instead of carrying a copy and a licence key each.

// Both naming conventions, because both are in the wild: <site>-access.log
// and access-<site>.log. Matching only one silently reads nothing at all --
// no error, no empty dashboard, just a service that never appears.
//
// Rotated files stay excluded: every glob ends in .log, so access.log.1 and
// access.log.9.gz match none of them. That is deliberate, see the note above.
local.file_match "nginx" {
  path_targets = [
    { __path__ = "/var/log/nginx/*-access.log", job = "nginx", service = "nginx-access" },
    { __path__ = "/var/log/nginx/*-error.log",  job = "nginx", service = "nginx-error"  },
    { __path__ = "/var/log/nginx/access-*.log", job = "nginx", service = "nginx-access" },
    { __path__ = "/var/log/nginx/error-*.log",  job = "nginx", service = "nginx-error"  },
  ]
}

// site comes from the path at discovery time rather than from a pipeline
// stage, so it is a real stream label before the first line is read. Kept
// verbatim: dashes are NOT converted back to dots, because a domain that
// genuinely contains a hyphen would be ambiguous.
//
// One regex for both conventions: it strips a leading access-/error- or a
// trailing -access/-error, and keeps everything else.
//
//   example.com-access.log   -> example.com
//   access-example.com.log   -> example.com
//   error-boxname-shop.log   -> boxname-shop
//
// That last line is worth reading twice. Whatever is left after stripping IS
// the site label, and it is what every dashboard groups by. If the filename
// carries a box or environment prefix, that prefix ends up in the label --
// harmless for grouping, but it will no longer match a domain, so the Route 53
// charge-to mapping cannot line it up. Name the files after the domain if you
// want that to work.
//
// NGINX_SITE_REGEX overrides this for a box that names files some third way.
// It must contain exactly one capture group, and that group becomes the label.
discovery.relabel "nginx" {
  targets = local.file_match.nginx.targets

  rule {
    source_labels = ["__path__"]
    regex         = coalesce(sys.env("NGINX_SITE_REGEX"), "/var/log/nginx/(?:(?:access|error)-)?(.+?)(?:-(?:access|error))?\\.log")
    target_label  = "site"
  }
}

loki.source.file "nginx" {
  targets    = discovery.relabel.nginx.output
  forward_to = [loki.process.nginx.receiver]
}

// --- one-off backfill ------------------------------------------------------
// Inert unless NGINX_BACKFILL_DIR is set. The path here is the one INSIDE the
// container, fixed by the compose mount; NGINX_BACKFILL_DIR only says which
// host directory lands on it, exactly as NGINX_LOG_DIR does. Unset, compose
// mounts /dev/null there and these globs match nothing. For getting history in
// after the
// fact: decompress the rotated logs you want into that directory named
// <site>-access.log, start the stack, watch it drain, then unset it again.
//
// Why a separate directory rather than widening the globs above: the live
// globs deliberately exclude .log.1 and .log.N.gz, because logrotate renames
// files into positions Alloy has already read and every restart and midnight
// would re-ingest months of history. Backfill is a thing you do once, on
// purpose, to a set of files you chose.
//
// The backfill label is load-bearing, not decoration. Loki accepts
// out-of-order writes only within a window relative to a stream's head, so
// pushing fortnight-old lines into a stream that already holds today's is
// refused with "entry too far behind". A distinct label makes it a separate
// stream with its own head, while {service="nginx-access"} still matches it
// -- so every dashboard sees the backfilled data with no query changes.
local.file_match "nginx_backfill" {
  path_targets = [
    { __path__ = "/var/log/nginx-backfill/*-access.log",
      job = "nginx", service = "nginx-access", backfill = "true" },
    { __path__ = "/var/log/nginx-backfill/*-error.log",
      job = "nginx", service = "nginx-error", backfill = "true" },
    { __path__ = "/var/log/nginx-backfill/access-*.log",
      job = "nginx", service = "nginx-access", backfill = "true" },
    { __path__ = "/var/log/nginx-backfill/error-*.log",
      job = "nginx", service = "nginx-error", backfill = "true" },
  ]
}

discovery.relabel "nginx_backfill" {
  targets = local.file_match.nginx_backfill.targets

  // Same extraction as the live pipeline, and it has to be: a backfilled
  // line landing under a different site label than the live lines for the
  // same site would split one site's history in two, silently.
  rule {
    source_labels = ["__path__"]
    regex         = coalesce(sys.env("NGINX_SITE_REGEX_BACKFILL"), ".*/(?:(?:access|error)-)?(.+?)(?:-(?:access|error))?\\.log")
    target_label  = "site"
  }
}

loki.source.file "nginx_backfill" {
  targets    = discovery.relabel.nginx_backfill.output
  forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
  forward_to = [loki.write.aggregator.receiver]

  // Alloy's own age gate, ahead of Loki's. It exists so a re-read of an old
  // file cannot flood ingest. Raise it with LOG_MAX_AGE to backfill, and note
  // it is only the first gate: the aggregator's Loki independently refuses
  // anything past reject_old_samples_max_age, and for nginx the live globs
  // match no rotated file at all. See the backfill block at the end.
  stage.drop {
    older_than          = coalesce(sys.env("LOG_MAX_AGE"), "168h")
    drop_counter_reason = "too_old_for_loki"
  }

  // 1:1 with site, and hundreds of long filenames make every label dropdown
  // unusable.
  stage.label_drop {
    values = ["filename"]
  }

  stage.match {
    selector = "{service=\"nginx-access\"}"

    // Only the timestamp is extracted. method, path, status, referer, user
    // agent and client address are read at query time with | pattern, which
    // costs nothing until asked for and applies to lines already stored.
    stage.regex {
      expression = "^\\S+ \\S+ \\S+ \\[(?P<ts>[^\\]]+)\\]"
    }
    stage.timestamp {
      source = "ts"
      format = "02/Jan/2006:15:04:05 -0700"
    }
    stage.static_labels {
      values = { level = "info" }
    }

    // --- our own uptime monitor, dropped outright --------------------------
    //
    // Uptime Kuma polls every site's front page around the clock. Left in, it
    // is the busiest "visitor" on quiet sites, inflates Requests and Visitors,
    // and sits at the top of Top client addresses. It is not traffic, so it is
    // not shipped at all. Both the address AND the agent have to match: a
    // stranger copying the agent string still gets logged, and so does
    // anything else that comes from our monitor's address.
    //
    // MONITOR_IPS is a regex alternation of addresses, dots escaped, set per
    // box in .env -- never here, this repo is shared. Unset, the placeholder
    // can match no address, so nothing is dropped.
    stage.drop {
      expression          = "^(" + coalesce(sys.env("MONITOR_IPS"), "MONITOR_IPS-unset") + ") .*\"Uptime-Kuma/"
      drop_counter_reason = "own_uptime_monitor"
    }

    // --- bot classification, decided once, here --------------------------
    //
    // Every dashboard wants "human traffic only", and the obvious way to get
    // it is a 50-branch regex over the user agent at query time. That runs
    // against every parsed line on every panel load, and on a site with a
    // fortnight of history behind it, it is the whole cost of the query --
    // 14-day views time out on it.
    //
    // Deciding it at ingest turns that into a stream label. `bot` has two
    // values, so it at most doubles the stream count, and in exchange
    // {bot!="true"} becomes a stream selector: Loki skips whole chunks of
    // automated traffic without reading them.
    //
    // The agent is the LAST of the two adjacent quoted fields. That holds for
    // stock combined and for the extended format with rt=/urt=/host= after
    // it, because the referer and agent stay adjacent in both.
    stage.regex {
      expression = "\"[^\"]*\"\\s+\"(?P<agent>[^\"]*)\""
    }
    stage.template {
      source   = "bot"
      template = "{{ if regexMatch \"(?i)(bot|crawl|spider|slurp|uptime|monitor|pingdom|statuscake|curl|wget|python|scrapy|httpclient|okhttp|java|go-http|libwww|perl|ruby|axios|node-fetch|headless|phantom|puppeteer|playwright|ahrefs|semrush|mj12|dotbot|petal|bytespider|gptbot|claudebot|ccbot|amazonbot|applebot|facebookexternalhit|dataforseo|serpstat|zoominfo|censys|masscan|zgrab|nmap|nuclei|wpscan)\" .agent }}true{{ else }}false{{ end }}"
    }
    // Only bot is promoted. agent stays an extracted value and is read at
    // query time by | pattern, as before -- putting it in a label would be
    // catastrophic cardinality.
    stage.labels {
      values = { bot = "" }
    }
  }

  stage.match {
    selector = "{service=\"nginx-error\"}"

    // nginx error lines carry no UTC offset, so the host's zone has to be
    // supplied. A wrong value here shifts every error by hours and nothing
    // about that failure is loud.
    stage.regex {
      expression = "^(?P<ts>\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[(?P<level>\\w+)\\]"
    }
    stage.timestamp {
      source   = "ts"
      format   = "2006/01/02 15:04:05"
      location = sys.env("TZ")
    }
    stage.labels {
      values = { level = "" }
    }
  }
}

// --- Traefik access log ----------------------------------------------------
// For a box whose sites are served by Traefik rather than an nginx vhost per
// site: box 2 of the AWS site platform (QuestaSearch docs/18 §10). Inert
// unless TRAEFIK_LOG_DIR is set: with it unset the compose file mounts
// /dev/null at /var/log/traefik and this glob matches nothing.
//
// The per-site dashboards and the ruler's recording rules read nginx
// combined lines with | pattern, and the relay in front of Loki resolves
// country from the first field of the line. Traefik writes JSON. Mapping
// Traefik's fields onto labels is not enough for that -- the dashboards parse
// the line itself -- so each access line is REWRITTEN into nginx's extended
// combined format and handed to the nginx pipeline above. From there it is an
// nginx-access line like any other: same timestamp handling, same uptime
// monitor drop, same bot classification (one regex, not a copy of it), same
// labels. Nothing downstream changes.
//
//   {"ClientHost":"203.0.113.7","RequestMethod":"GET","RequestPath":"/a?q=1",
//    "RequestProtocol":"HTTP/2.0","DownstreamStatus":200,
//    "DownstreamContentSize":5120,"request_Referer":"https://x/",
//    "request_User-Agent":"Mozilla/5.0 ...","RequestHost":"www.example.com",
//    "RouterName":"site_example_com_www@file","Duration":12345678,
//    "StartUTC":"2026-09-24T12:50:01.123456789Z", ...}
//   ->
//   203.0.113.7 - - [24/Sep/2026:12:50:01 +0000] "GET /a?q=1 HTTP/2.0" 200 5120
//     "https://x/" "Mozilla/5.0 ..." rt=0.012 host=www.example.com
//
// rt= and host= after the agent are the extended format some nginx boxes
// already write; | pattern ignores them, and they keep Traefik's duration and
// the hostname actually asked for (www./cdn./search. all count as the site).
//
// The site label comes from the ROUTER, never from the Host header. Router
// names are written by one program from signed manifests (site_<domain with
// dots as underscores>[_www|_cdn|_search]@file, builder/src/edge/traefik.ts),
// so the label's values are bounded by the sites actually published. A Host
// header is whatever a scanner sends, and as a label it would be unbounded.
// Everything else -- the internal hostnames, unmatched hosts, the http->https
// redirect -- is site="catch-all", which the dashboard sync skips.
//
// The label is the domain with dots as DASHES -- iviewdaily.com logs as
// site="iviewdaily-com" -- the same spelling the nginx boxes produce from
// their per-vhost filenames. That is deliberate: a site that moves from an
// nginx box onto the platform keeps its label, so its dashboards (uids,
// history) and every Custom dashboard that lists it carry straight over.
// A dotted label would have been a second, separate site.
//
// TRAEFIK_SITE_ROUTER_REGEX overrides the router convention: one capture
// group, underscores in it become dashes, no backticks.
local.file_match "traefik" {
  path_targets = [
    { __path__ = "/var/log/traefik/access.log", job = "traefik", service = "traefik-access" },
  ]
}

loki.source.file "traefik" {
  targets    = local.file_match.traefik.targets
  forward_to = [loki.process.traefik.receiver]
}

loki.process "traefik" {
  forward_to = [loki.process.nginx.receiver]

  stage.json {
    expressions = {
      ts         = "StartUTC",
      ip         = "ClientHost",
      method     = "RequestMethod",
      path       = "RequestPath",
      proto      = "RequestProtocol",
      status     = "DownstreamStatus",
      size       = "DownstreamContentSize",
      referer    = "\"request_Referer\"",
      agent      = "\"request_User-Agent\"",
      host       = "RequestHost",
      router     = "RouterName",
      duration   = "Duration",
      entrypoint = "entryPointName",
    }
  }

  // Not an access line (Traefik writes nothing else to this file, but a line
  // cut short by a crash would otherwise reach Loki as a malformed request).
  // A template that renders empty REMOVES its key, so the marker is set only
  // for the lines to drop, and the drop keys on its presence.
  stage.template {
    source   = "not_access"
    template = "{{ if and .status .ip .ts .method }}{{ else }}yes{{ end }}"
  }
  stage.drop {
    source              = "not_access"
    drop_counter_reason = "traefik_not_access_line"
  }

  // The healthcheck and Prometheus scrapes on the internal entrypoint are
  // not traffic. Traefik leaves requests to its internal services out of the
  // access log unless accessLog.addInternals is on, so this is a backstop.
  stage.drop {
    source              = "entrypoint"
    value               = coalesce(sys.env("TRAEFIK_INTERNAL_ENTRYPOINT"), "metrics")
    drop_counter_reason = "traefik_internal_entrypoint"
  }

  stage.template {
    source   = "site"
    template = "{{ $re := `" + coalesce(sys.env("TRAEFIK_SITE_ROUTER_REGEX"), "^site_([a-z0-9_-]+?)(?:_www|_cdn|_search)?@file$") + "` }}{{ if .router }}{{ if regexMatch $re .router }}{{ regexReplaceAllLiteral \"_\" (regexReplaceAll $re .router \"${1}\") \"-\" }}{{ else }}catch-all{{ end }}{{ else }}catch-all{{ end }}"
  }

  // nginx's $time_local, in UTC: the nginx pipeline takes the timestamp from
  // here, exactly as it does for a file nginx wrote. Second precision, as
  // nginx's is.
  stage.template {
    source   = "ts"
    template = "{{ dateInZone \"02/Jan/2006:15:04:05 -0700\" (toDate \"2006-01-02T15:04:05.999999999Z07:00\" .Value) \"UTC\" }}"
  }

  // Duration is nanoseconds; nginx's $request_time is seconds to the
  // millisecond.
  stage.template {
    source   = "rt"
    template = "{{ if .duration }}{{ printf \"%.3f\" (divf .duration 1000000000) }}{{ else }}-{{ end }}"
  }

  // nginx writes a double quote inside a quoted field as \x22, which is what
  // keeps "<referer>" "<agent>" parseable. Empty is "-", as nginx logs it.
  stage.template {
    source   = "path"
    template = "{{ Replace .Value `\"` `\\x22` -1 }}"
  }
  stage.template {
    source   = "referer"
    template = "{{ if .Value }}{{ Replace .Value `\"` `\\x22` -1 }}{{ else }}-{{ end }}"
  }
  stage.template {
    source   = "agent"
    template = "{{ if .Value }}{{ Replace .Value `\"` `\\x22` -1 }}{{ else }}-{{ end }}"
  }

  stage.template {
    source   = "line"
    template = "{{ .ip }} - - [{{ .ts }}] \"{{ .method }} {{ .path }} {{ .proto }}\" {{ .status }} {{ if .size }}{{ .size }}{{ else }}0{{ end }} \"{{ .referer }}\" \"{{ .agent }}\" rt={{ .rt }} host={{ if .host }}{{ .host }}{{ else }}-{{ end }}"
  }
  stage.output {
    source = "line"
  }

  // From here on it is an nginx access line; the nginx pipeline drops the
  // filename label and sets level and bot.
  stage.static_labels {
    values = {
      job     = "nginx",
      service = "nginx-access",
    }
  }
  stage.labels {
    values = { site = "" }
  }
}
